{
  "name": "subscription-catalogue",
  "productName": "Subscroll",
  "version": "0.6.0",
  "description": "Every game you already pay for, in one place.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "snapshot": "node scripts/build-snapshot.js",
    "dist:win": "electron-builder --win portable --x64",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "local.subscroll",
    "files": [
      "src/**",
      "renderer/**",
      "data/**",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Subscroll-${version}.exe",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "Subscroll-${version}-${arch}.${ext}",
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "identity": null
    },
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "linux": {
      "target": "AppImage",
      "artifactName": "Subscroll-${version}.${ext}",
      "icon": "build/icon.png",
      "category": "Game",
      "synopsis": "Every game you already pay for, in one place.",
      "executableName": "subscroll",
      "syncDesktopName": true
    },
    "productName": "Subscroll",
    "publish": null,
    "afterPack": "scripts/adhoc-sign.js"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/viruztt/subscroll.git"
  },
  "desktopName": "subscroll.desktop",
  "author": "Šarūnas Rimša"
}
